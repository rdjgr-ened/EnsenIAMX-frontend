# ==============================================================================
# ENSEÑIA MX - VARIABLES DE ENTORNO / CONFIGURACIÓN DE DESPLIEGUE (VERCEL & LOCAL)
# ==============================================================================
# Copia este archivo como .env en tu entorno local o configúralas en el Dashboard de Vercel:
# Settings -> Environment Variables

# ------------------------------------------------------------------------------
# 1. GOOGLE GEMINI AI (Obligatorio para la generación pedagógica con IA)
# ------------------------------------------------------------------------------
# Obtén tu API Key gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="tu-gemini-api-key-aqui"
VITE_GEMINI_API_KEY="tu-gemini-api-key-aqui"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Obligatorio para usuarios, planes y base curricular)
# ------------------------------------------------------------------------------
# Obtén tus credenciales en el dashboard de Supabase (Project Settings -> API):
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="tu-supabase-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="tu-supabase-service-role-key-aqui"

# Variables para el cliente Vite (Frontend)
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-supabase-anon-key-aqui"

# ------------------------------------------------------------------------------
# 3. MERCADO PAGO (Para procesamiento de pagos, suscripciones y recargas)
# ------------------------------------------------------------------------------
# Obtén tus credenciales en Mercado Pago Developers:
# https://www.mercadopago.com.mx/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MERCADOPAGO_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"

# ------------------------------------------------------------------------------
# 4. URL DE LA APLICACIÓN
# ------------------------------------------------------------------------------
# URL pública donde está alojada la app (útil para webhooks y redirecciones)
# En desarrollo local: http://localhost:3000
# En producción (Vercel): https://tu-dominio.vercel.app
APP_URL="http://localhost:3000"
